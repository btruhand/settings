# Install brew

SETTINGS_DIR=$(get_settings_dir)

if ! is_installed? brew && should "Detected no brew. Install brew?"; then
	/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
	source ~/.zprofile
fi

# Below use the full expected /opt/homebrew/bin/brew path in case brew was just installed

if should "Install coreutils?"; then
	/opt/homebrew/bin/brew install coreutils
fi

if should "Install vim?"; then
	/opt/homebrew/bin/brew install vim
fi

if should "Install cmake?"; then
	/opt/homebrew/bin/brew install cmake
fi

if should "Install brew java?"; then
	/opt/homebrew/bin/brew install java
fi

if should "Install libtool?"; then
	/opt/homebrew/bin/brew install libtool
fi

if should "Install graphviz?"; then
	/opt/homebrew/bin/brew install graphviz
fi

if should "Install bash?"; then
	/opt/homebrew/bin/brew install bash
fi

if should "Install bash-completion@2"; then
	/opt/homebrew/bin/brew install bash-completion@2
fi

# brew pyenv
if should "Install uv?"; then
	/opt/homebrew/bin/brew install uv
fi

# brew rbenv
if should "Install rbenv?"; then
	/opt/homebrew/bin/brew install rbenv
	rbenv init
fi

# brew shfmt
if should "Install shfmt?"; then
	/opt/homebrew/bin/brew install shfmt
fi

# brew direnv
if should "Install direnv?"; then
	/opt/homebrew/bin/brew install direnv
	mkdir -p $HOME/.config/direnv
	ln -sf $SETTINGS_DIR/direnv/direnvrc $HOME/.config/direnv/direnvrc
fi

if should "Install fzf?"; then
	/opt/homebrew/bin/brew install fzf
	$(/opt/homebrew/bin/brew --prefix)/opt/fzf/install
fi

if should "Install tldr?"; then
	/opt/homebrew/bin/brew install tldr
fi

if should "Install xsel?"; then
	/opt/homebrew/bin/brew install xsel
fi

if should "Install bat? (Rust version of cat)"; then
	/opt/homebrew/bin/brew install bat
fi

echo "Checking /opt/homebrew/bin/brew health through brew doctor..."
/opt/homebrew/bin/brew doctor
